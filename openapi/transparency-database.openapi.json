          "incompatible_content_ground": {
            "type": "string",
            "maxLength": 500,
            "description": "Incompatible content grounds"
          },
          "incompatible_content_explanation": {
            "type": "string",
            "maxLength": 2000,
            "description": "Incompatible content explanation"
          },
          "incompatible_content_illegal": {
            "type": "string",
            "enum": [
              "Yes",
              "No"
            ],
            "description": "Incompatible content illegal"
          },
          "content_type": {
            "type": "array",
            "items": {
