            },
            "description": "Decision visibility"
          },
          "decision_visibility_other": {
            "type": "string",
            "maxLength": 500,
            "description": "Decision visibility other"
          },
          "decision_monetary": {
            "type": "string",
            "enum": [
              "DECISION_MONETARY_SUSPENSION",
              "DECISION_MONETARY_TERMINATION",
              "DECISION_MONETARY_OTHER"
            ],
            "description": "Monetary payments suspension, termination or other restriction"
          },
          "decision_monetary_other": {
            "type": "string",
            "maxLength": 500,
            "description": "Decision monetary other"
          },
          "decision_provision": {
            "type": "string",
            "enum": [
              "DECISION_PROVISION_PARTIAL_SUSPENSION",
              "DECISION_PROVISION_TOTAL_SUSPENSION",
              "DECISION_PROVISION_PARTIAL_TERMINATION",
              "DECISION_PROVISION_TOTAL_TERMINATION"
            ],
            "description": "Decision about the provisioning of the service"
          },
          "decision_account": {
            "type": "string",
            "enum": [
              "DECISION_ACCOUNT_SUSPENDED",
              "DECISION_ACCOUNT_TERMINATED"
