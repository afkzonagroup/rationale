              "ACCOUNT_TYPE_PRIVATE"
            ],
            "description": "Account type"
          },
          "decision_facts": {
            "type": "string",
            "maxLength": 5000,
            "description": "Facts and circumstances relied on in taking the decision"
          },
          "decision_ground": {
            "type": "string",
            "enum": [
