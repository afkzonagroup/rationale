            "description": "Decision grounds"
          },
          "decision_ground_reference_url": {
            "type": "string",
            "format": "uri",
            "maxLength": 500,
            "description": "Decision ground reference URL"
          },
          "illegal_content_legal_ground": {
            "type": "string",
            "maxLength": 500,
            "description": "Illegal content legal grounds"
          },
          "illegal_content_explanation": {
            "type": "string",
            "maxLength": 2000,
            "description": "Illegal content explanation"
