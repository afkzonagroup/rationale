      "StatementCreated": {
        "type": "object",
        "required": [
          "uuid",
          "puid"
        ],
        "properties": {
          "uuid": {
            "type": "string",
            "format": "uuid"
          },
          "puid": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          },
          "permalink": {
            "type": "string"
          },
          "self": {
            "type": "string"
          },
          "platform_name": {
            "type": "string"
          }
        }
      },
      "StatementBatch": {
        "type": "object",
        "required": [
          "statements"
        ],
        "properties": {
          "statements": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/Statement"
            }
          }
        }
      },
      "StatementBatchCreated": {
        "type": "object",
        "required": [
          "statements"
        ],
        "properties": {
          "statements": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StatementCreated"
            }
          }
        }
      },
      "ErrorBody": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "errors": {
            "type": "object",
            "additionalProperties": true
          },
          "existing": {
            "type": "object",
            "properties": {
              "puid": {
                "type": "string"
              }
            }
          }
        }
      },
      "PuidLookup": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "puid": {
            "type": "string"
          }
        }
      }
