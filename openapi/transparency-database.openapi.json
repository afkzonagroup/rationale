{
  "openapi": "3.1.0",
  "info": {
    "title": "DSA Transparency Database: statement of reasons submission (unofficial description)",
    "version": "2025-07-01+a3444a9c",
    "description": "Derived by Rationale from the official source code (https://github.com/digital-services-act/transparency-database at a3444a9c5ae96640ff0978e92205c9c654909a37) and the API documentation (https://transparency.dsa.ec.europa.eu/page/api-documentation). The Commission does not publish an OpenAPI document; this file is not official."
  },
  "servers": [
    {
      "url": "https://transparency.dsa.ec.europa.eu",
      "description": "Production. The sandbox host is given to each platform during onboarding."
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Statement": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "decision_facts",
          "decision_ground",
          "content_type",
          "category",
          "content_date",
          "application_date",
          "source_type",
          "automated_detection",
          "automated_decision",
          "puid"
        ],
        "properties": {
          "decision_visibility": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "DECISION_VISIBILITY_CONTENT_REMOVED",
                "DECISION_VISIBILITY_CONTENT_DISABLED",
                "DECISION_VISIBILITY_CONTENT_DEMOTED",
                "DECISION_VISIBILITY_CONTENT_AGE_RESTRICTED",
                "DECISION_VISIBILITY_CONTENT_INTERACTION_RESTRICTED",
                "DECISION_VISIBILITY_CONTENT_LABELLED",
                "DECISION_VISIBILITY_OTHER"
