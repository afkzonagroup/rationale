  "paths": {
    "/api/v1/statement": {
      "post": {
        "operationId": "createStatement",
        "security": [
          {
            "bearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Statement"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatementCreated"
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated"
          },
          "422": {
            "description": "Validation error or PUID not unique",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit reached"
          }
        }
      }
    },
    "/api/v1/statements": {
      "post": {
        "operationId": "createStatements",
        "security": [
          {
            "bearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StatementBatch"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatementBatchCreated"
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated"
          },
          "422": {
            "description": "Validation error (errors.statement_N) or PUIDs not unique (errors.existing_puids); nothing was created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit reached"
          }
        }
      }
    },
    "/api/v1/statement/existing-puid/{puid}": {
      "get": {
        "operationId": "existingPuid",
        "security": [
          {
            "bearer": []
          }
        ],
        "parameters": [
          {
            "name": "puid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "A statement with this PUID exists",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PuidLookup"
                }
              }
            }
          },
          "404": {
            "description": "No statement with this PUID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PuidLookup"
                }
              }
            }
          }
        }
      }
    }
  }
}
